# Use PHP5.3 Single php.ini as default

RewriteEngine On 
RewriteCond %{HTTPS} off 
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301] 
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTPS/ 
RewriteRule ^index\.html$ https://www.gdprowebdesigns.com/ [R=301,L] 

## Redirect from .gdprowebdesigns.com to www.gdprowebdesigns.com ##

RewriteEngine On

RewriteCond %{SERVER_PORT} ^80$
RewriteCond %{HTTPS_HOST} ^gdprowebdesigns.com$
RewriteRule ^(/)?(.*) https://www.gdprowebdesigns.com/$2 [R=301,L]

##404 error pages##
ErrorDocument 404 /404.html

