RewriteRule ^gd-blog/service-area/newton/$ https://gdprowebdesigns.com/newton-ma-web-designer-web-developer.html [R=301,L]

# --- Archived Spanish pages ---
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^disenador-paginas-web-freelancer-boston-off\.html$ https://gdprowebdesigns.com/disenador-paginas-web-freelancer-boston.html [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
