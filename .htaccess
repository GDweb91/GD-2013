RewriteRule ^web-designer-developer-for-small-business-boston-ma\.html$ https://gdprowebdesigns.com/gd-blog/web-developer-ma/ [R=301,L]

# FIX: typo in original filename (dsigner)
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^web-dsigner-developer-for-small-business-boston-ma\.html$ https://gdprowebdesigns.com/gd-blog/web-developer-ma/ [R=301,L]

# --- SEO pages — canonical is organic-SEO-everett-ma.html ---
# FIX: was previously redirecting organic-SEO-everett-ma.html → seo-services-everett-ma.html (wrong direction)
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^seo-services-everett-ma\.html$ https://gdprowebdesigns.com/organic-SEO-everett-ma.html [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^everett-ma-local-seo-services\.html$ https://gdprowebdesigns.com/organic-SEO-everett-ma.html [R=301,L]

# --- Local marketing — FIX: was missing domain in redirect target ---
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^local-marketing-boston-everett-malden-medford-revere-saugus-ma\.html$ https://gdprowebdesigns.com/local-marketing-company-everett-malden-medford-revere-saugus-ma.html [R=301,L]

# --- About page (old URLs) ---
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^about-gd-freelance-web-developers-boston(-off)?\.html$ https://gdprowebdesigns.com/about-gd-freelance-web-designer-boston.html [R=301,L]

# --- Dedham — FIX: meta-refresh converted to proper 301 ---
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^Dedham-MA-freelance-wordpress-developer\.html$ https://gdprowebdesigns.com/Dedham-ma-freelance-web-developer.html [R=301,L]

