# --- Boston web design consolidation → web-design-company-boston-ma.html ---
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^web-design-Boston-MA\.html$ https://gdprowebdesigns.com/web-design-company-boston-ma.html [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^boston-web-design-development-company\.html$ https://gdprowebdesigns.com/web-design-company-boston-ma.html [R=301,L]

# FIX: meta-refresh was pointing here; now a proper 301 direct to canonical
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^boston-web-design-development-company-freelance\.html$ https://gdprowebdesigns.com/web-design-company-boston-ma.html [R=301,L]

# Responsive web design (archived — both spaced and hyphenated variants)
RewriteCond %{HTTP_HOST} ^(www\.)?gdprowebdesigns\.com$
RewriteRule ^responsive[-\ ]web-design-development-boston-ma\.html$ https://gdprowebdesigns.com/web-design-company-boston-ma.html [R=301,L]

# --- WordPress developer pages ---
